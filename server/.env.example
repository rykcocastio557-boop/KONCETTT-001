# ============================================
#  MR.RCT Executive Vault — Environment Template
#  Copy file ini jadi .env lalu isi value asli
# ============================================

# ====== SERVER ======
PORT=3000
API_SECRET=ganti_dengan_secret_random_kamu
ALLOWED_ORIGIN=*

# ====== FIREBASE ADMIN ======
# Ambil dari: Firebase Console → Project Settings
# → Service Accounts → Generate new private key
FB_PROJECT_ID=database-portal-1c1b0
FB_CLIENT_EMAIL=firebase-adminsdk-xxxxx@database-portal-1c1b0.iam.gserviceaccount.com
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_KAMU_DISINI\n-----END PRIVATE KEY-----\n"
FB_DATABASE_URL=https://database-portal-1c1b0-default-rtdb.firebaseio.com

# ====== TELEGRAM BOT ======
# Buat bot di @BotFather, copy token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
